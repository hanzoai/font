{
  "name": "@hanzo/font",
  "version": "1.8.8",
  "description": "Zen \u2014 the Hanzo type family: sans, mono and pixel, with brand presets.",
  "main": "./dist/font.js",
  "type": "module",
  "module": "./dist/font.js",
  "types": "./font.d.ts",
  "scripts": {
    "prepare": "cp ../../LICENSE.txt .",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "homepage": "https://hanzo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://git.hanzo.ai/hanzoai/font.git",
    "directory": "packages/zen"
  },
  "keywords": [
    "zen",
    "zen sans",
    "zen mono",
    "zen pixel",
    "hanzo",
    "font",
    "typeface"
  ],
  "exports": {
    ".": {
      "types": "./dist/font.d.ts",
      "default": "./dist/font.js"
    },
    "./mono": {
      "types": "./dist/mono.d.ts",
      "default": "./dist/mono.js"
    },
    "./mono-non-variable": {
      "types": "./dist/mono-non-variable.d.ts",
      "default": "./dist/mono-non-variable.js"
    },
    "./sans": {
      "types": "./dist/sans.d.ts",
      "default": "./dist/sans.js"
    },
    "./sans-non-variable": {
      "types": "./dist/sans-non-variable.d.ts",
      "default": "./dist/sans-non-variable.js"
    },
    "./pixel": {
      "types": "./dist/pixel.d.ts",
      "default": "./dist/pixel.js"
    },
    "./css": "./dist/zen.css",
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./presets.css": "./dist/presets.css",
    "./dist/fonts/*": "./dist/fonts/*"
  },
  "license": "SIL OPEN FONT LICENSE",
  "peerDependencies": {
    "next": ">=13.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ]
}
